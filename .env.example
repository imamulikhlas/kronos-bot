# Salin file ini menjadi ".env" lalu isi.
# PENTING: saat membuat API key di Tokocrypto, aktifkan hanya izin BACA + SPOT TRADING.
#          JANGAN aktifkan izin WITHDRAW. Batasi ke IP komputer Anda jika ada pilihannya.
TOKOCRYPTO_API_KEY=
TOKOCRYPTO_API_SECRET=

# Kunci pengaman kedua untuk mode live. Ubah menjadi YA hanya jika Anda benar-benar siap
# trading dengan uang sungguhan (selain mengubah mode: live di config.yaml).
LIVE_TRADING=TIDAK
